generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                    @id @default(cuid())
  email                String?                   @unique
  username             String                    @unique
  displayName          String
  passwordHash         String?
  phone                String?                   @unique
  authProvider         String                    @default("email")
  wordpressUserId      Int?                      @unique
  role                 UserRole                  @default(EDITOR)
  tenantId             String?
  onboardingStatus     VerificationStatus        @default(DRAFT)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  fcm_token            String?
  fcm_token_updated_at DateTime?                 @db.Timestamptz(6)
  assignmentsHandled   Assignment[]              @relation("AssignmentHandledBy")
  managedConversations ConversationParticipant[]
  leadsCreated         Lead[]                    @relation("LeadCreatedBy")
  notifications        Notification[]
  teamInvitesSent      TeamMembership[]          @relation("TeamMembershipInvitedBy")
  ownedTenant          Tenant?                   @relation("TenantOwner")
  tenant               Tenant?                   @relation("TenantStaff", fields: [tenantId], references: [id])
}

model SalesSettings {
  id                            String   @id @default("sales-settings")
  moduleEnabled                 Boolean  @default(true)
  signupRequiresApproval        Boolean  @default(true)
  defaultCommissionPercent      Decimal  @default(10) @db.Decimal(5, 2)
  payoutMinimum                 Decimal  @default(500) @db.Decimal(12, 2)
  enableAnnouncements           Boolean  @default(true)
  enableMessages                Boolean  @default(true)
  enableReferralLinks           Boolean  @default(true)
  enableTeams                   Boolean  @default(true)
  enableEarnings                Boolean  @default(true)
  enablePayouts                 Boolean  @default(true)
  enablePackageLinks            Boolean  @default(true)
  dashboardPrimaryColor         String   @default("#D7FF1F")
  dashboardAccentColor          String   @default("#050816")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  closerDirectCommissionPercent Decimal? @default(20.00) @db.Decimal(5, 2)
  closerSubCommissionPercent    Decimal? @default(10.00) @db.Decimal(5, 2)
  freelancerCommissionPercent   Decimal? @default(10.00) @db.Decimal(5, 2)
  agencyCommissionPercent       Decimal? @default(10.00) @db.Decimal(5, 2)
  payoutHoldDays                Int?     @default(7)
  aiAutoReplyEnabled            Boolean  @default(true)
  aiAutoReplyUpdatedById        String?
  aiAutoReplyUpdatedByName      String?
  tenantId                      String?  @unique
  showOnlyAssignedChats         Boolean  @default(true)
}

model SalesAgentGroup {
  id                       String                @id @default(cuid())
  name                     String
  description              String?
  defaultCommissionPercent Decimal               @default(10) @db.Decimal(5, 2)
  parentCommissionPercent  Decimal               @default(2) @db.Decimal(5, 2)
  maxDiscountPercent       Decimal?              @db.Decimal(5, 2)
  isActive                 Boolean               @default(true)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  tenantId                 String?
  agents                   SalesAgentProfile[]
  commissionRules          SalesCommissionRule[]
  salesGoals               SalesGoal[]
  salesRewards             SalesReward[]

  @@index([tenantId])
}

model SalesAgentProfile {
  id                  String                    @id @default(cuid())
  userId              String                    @unique
  groupId             String?
  parentAgentId       String?
  agentCode           String                    @unique
  status              SalesAgentStatus          @default(PENDING)
  commissionPercent   Decimal?                  @db.Decimal(5, 2)
  payoutInfo          Json?
  totalPaidRevenue    Decimal                   @default(0) @db.Decimal(12, 2)
  outstandingEarnings Decimal                   @default(0) @db.Decimal(12, 2)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  canCreateSubAgents  Boolean                   @default(false)
  canClaimLeads       Boolean                   @default(true)
  maxActiveLeads      Int?
  permissions         Json?
  tenantId            String
  group               SalesAgentGroup?          @relation(fields: [groupId], references: [id])
  parentAgent         SalesAgentProfile?        @relation("SalesAgentTree", fields: [parentAgentId], references: [id])
  subAgents           SalesAgentProfile[]       @relation("SalesAgentTree")
  AicloserWorkspace   AicloserWorkspace         @relation(fields: [tenantId], references: [id])
  user                AppAuthUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissionRules     SalesCommissionRule[]
  deals               SalesDeal[]
  earnings            SalesEarning[]
  goals               SalesGoal[]
  leadAssignments     SalesLeadAssignment[]
  assignedPoolItems   SalesLeadPoolItem[]       @relation("SalesPoolAssignedAgent")
  claimedPoolItems    SalesLeadPoolItem[]       @relation("SalesPoolClaimedAgent")
  messageThreads      SalesMessageThread[]
  mobileCalls         SalesMobileCall[]
  mobileDevices       SalesMobileDevice[]
  mobileLeadPacks     SalesMobileLeadPack[]
  mobileEvents        SalesMobileOfflineEvent[]
  payouts             SalesPayout[]
  referralCodes       SalesReferralCode[]
  referralEvents      SalesReferralEvent[]
  rewards             SalesReward[]

  @@index([tenantId])
  @@index([groupId])
  @@index([parentAgentId])
  @@index([status])
}

model SalesLeadAssignment {
  id                  String             @id @default(cuid())
  leadId              String?
  assignedAgentId     String
  createdById         String?
  customerName        String
  customerPhone       String?
  customerEmail       String?
  source              String             @default("manual")
  serviceInterest     String?
  budgetAmount        Decimal?           @db.Decimal(10, 2)
  stage               SalesLeadStage     @default(NEW)
  followUpAt          DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  segment             String?
  priority            String             @default("normal")
  tags                String[]           @default([])
  conversationId      String?
  lastContactedAt     DateTime?
  tenantId            String
  aiScore             Int                @default(50)
  aiSentiment         String?
  aiSummary           String?
  customFields        Json               @default("{}")
  isDndActive         Boolean            @default(false)
  kanbanPosition      Float              @default(65536.0)
  lastCallDisposition String?
  lastCallDurationSec Int                @default(0)
  latestRecordingUrl  String?
  lostReason          String?
  lostReasonNotes     String?
  stageChangedAt      DateTime           @default(now())
  totalCallsCount     Int                @default(0)
  activityLogs        SalesActivityLog[]
  deals               SalesDeal[]
  assignedAgent       SalesAgentProfile  @relation(fields: [assignedAgentId], references: [id], onDelete: Cascade)
  createdBy           AppAuthUser?       @relation("SalesLeadCreatedBy", fields: [createdById], references: [id])
  lead                Lead?              @relation(fields: [leadId], references: [id])
  AicloserWorkspace   AicloserWorkspace  @relation(fields: [tenantId], references: [id])
  claimedPoolItem     SalesLeadPoolItem? @relation("SalesPoolConvertedAssignment")
  mobileCalls         SalesMobileCall[]

  @@unique([tenantId, customerPhone], map: "idx_salesleadassignment_tenant_phone")
  @@index([tenantId, createdAt])
  @@index([tenantId, stage])
  @@index([tenantId, stage, kanbanPosition])
  @@index([tenantId, conversationId])
  @@index([assignedAgentId, stage])
  @@index([leadId])
  @@index([conversationId])
  @@index([customerEmail(ops: raw("gin_trgm_ops"))], map: "SalesLeadAssignment_customerEmail_trgm_idx", type: Gin)
  @@index([customerName(ops: raw("gin_trgm_ops"))], map: "SalesLeadAssignment_customerName_trgm_idx", type: Gin)
  @@index([customerPhone(ops: raw("gin_trgm_ops"))], map: "SalesLeadAssignment_customerPhone_trgm_idx", type: Gin)
  @@index([tenantId, assignedAgentId])
  @@index([tenantId, customerPhone])
}

model CustomFieldDefinition {
  id           String   @id @default(cuid())
  tenantId     String
  fieldKey     String
  fieldLabel   String
  fieldType    String   @default("text")
  options      String[] @default([])
  defaultValue String?
  isRequired   Boolean  @default(false)
  showInKanban Boolean  @default(true)
  showInTable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, fieldKey])
  @@index([tenantId])
}

model LeadAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  leadId    String
  userId    String?
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, leadId, createdAt])
}

model SalesLeadPoolItem {
  id                    String               @id @default(cuid())
  assignedAgentId       String?
  claimedByAgentId      String?
  convertedAssignmentId String?              @unique
  customerName          String
  customerPhone         String?
  customerEmail         String?
  source                String               @default("round_robin")
  serviceInterest       String?
  segment               String?
  priority              String               @default("normal")
  budgetAmount          Decimal?             @db.Decimal(10, 2)
  status                SalesLeadPoolStatus  @default(OPEN)
  notes                 String?
  claimedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  conversationId        String?              @unique
  tenantId              String
  assignedAgent         SalesAgentProfile?   @relation("SalesPoolAssignedAgent", fields: [assignedAgentId], references: [id])
  claimedByAgent        SalesAgentProfile?   @relation("SalesPoolClaimedAgent", fields: [claimedByAgentId], references: [id])
  convertedAssignment   SalesLeadAssignment? @relation("SalesPoolConvertedAssignment", fields: [convertedAssignmentId], references: [id])
  AicloserWorkspace     AicloserWorkspace    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([assignedAgentId, status])
  @@index([claimedByAgentId])
}

/// Durable, idempotent delivery ledger for Meta Conversions API events.
/// No raw message text or access tokens are stored here.
model MetaConversionEvent {
  id                String   @id @default(cuid())
  eventId           String   @unique
  eventName         String
  source            String
  datasetId         String
  tenantId          String?
  conversationId    String?
  externalMessageId String?
  status            String   @default("PENDING")
  attemptCount      Int      @default(0)
  lastError         String?
  traceId           String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([source, createdAt])
  @@index([conversationId])
  @@index([externalMessageId])
  @@map("meta_conversion_events")
}

model SalesDeal {
  id                   String               @id @default(cuid())
  assignmentId         String
  agentId              String
  packageId            String?
  serviceId            String?
  quoteId              String?
  paymentTransactionId String?              @unique
  referralCodeId       String?
  title                String
  agreedAmount         Decimal              @db.Decimal(12, 2)
  paidAmount           Decimal              @default(0) @db.Decimal(12, 2)
  status               SalesDealStatus      @default(DRAFT)
  paymentReference     String?
  closedAt             DateTime?
  handoffNotes         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenantId             String?
  agent                SalesAgentProfile    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignment           SalesLeadAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  package              Package?             @relation(fields: [packageId], references: [id])
  paymentTransaction   PaymentTransaction?  @relation(fields: [paymentTransactionId], references: [id])
  referralCode         SalesReferralCode?   @relation(fields: [referralCodeId], references: [id])
  earnings             SalesEarning[]
  referralEvents       SalesReferralEvent[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([agentId, status])
  @@index([assignmentId])
  @@index([paymentTransactionId])
  @@index([referralCodeId])
}

model SalesCommissionRule {
  id                      String                   @id @default(cuid())
  name                    String
  type                    SalesCommissionRuleType
  scope                   SalesCommissionScope     @default(ALL_AGENTS)
  appliesTo               SalesCommissionAppliesTo @default(ALL_PACKAGES)
  groupId                 String?
  agentId                 String?
  packageId               String?
  serviceId               String?
  value                   Decimal                  @db.Decimal(10, 2)
  parentCommissionPercent Decimal?                 @db.Decimal(5, 2)
  minOrderValue           Decimal?                 @db.Decimal(12, 2)
  maxOrderValue           Decimal?                 @db.Decimal(12, 2)
  priority                Int                      @default(0)
  isActive                Boolean                  @default(true)
  startsAt                DateTime?
  endsAt                  DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tenantId                String?
  agent                   SalesAgentProfile?       @relation(fields: [agentId], references: [id])
  group                   SalesAgentGroup?         @relation(fields: [groupId], references: [id])
  package                 Package?                 @relation(fields: [packageId], references: [id])

  @@index([tenantId])
  @@index([scope, isActive, priority])
  @@index([agentId])
  @@index([packageId])
  @@index([serviceId])
}

model SalesEarning {
  id           String             @id @default(cuid())
  dealId       String
  agentId      String
  ruleId       String?
  amount       Decimal            @db.Decimal(12, 2)
  parentAmount Decimal            @default(0) @db.Decimal(12, 2)
  status       SalesEarningStatus @default(PENDING)
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  payoutId     String?
  tenantId     String?
  agent        SalesAgentProfile  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deal         SalesDeal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  payout       SalesPayout?       @relation(fields: [payoutId], references: [id])

  @@index([tenantId, createdAt])
  @@index([agentId, status])
  @@index([dealId])
}

model SalesPayout {
  id          String            @id @default(cuid())
  agentId     String
  amount      Decimal           @db.Decimal(12, 2)
  status      SalesPayoutStatus @default(REQUESTED)
  note        String?
  requestedAt DateTime          @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenantId    String?
  earnings    SalesEarning[]
  agent       SalesAgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([agentId, status])
}

model SalesReferralCode {
  id                 String                 @id @default(cuid())
  agentId            String
  code               String                 @unique
  label              String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  campaignId         String?
  discountType       CouponDiscountType?
  discountValue      Decimal?               @db.Decimal(12, 2)
  eligiblePackageIds String[]               @default([])
  maxRedemptions     Int?
  perUserLimit       Int                    @default(1)
  startsAt           DateTime?
  expiresAt          DateTime?
  discountDuration   CouponDiscountDuration @default(FIRST_CYCLE)
  tenantId           String?
  redemptions        CouponRedemption[]
  deals              SalesDeal[]
  agent              SalesAgentProfile      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  campaign           CouponCampaign?        @relation(fields: [campaignId], references: [id])
  events             SalesReferralEvent[]

  @@index([tenantId])
  @@index([campaignId])
}

model CouponCampaign {
  id                 String                 @id @default(cuid())
  name               String
  discountType       CouponDiscountType
  discountValue      Decimal                @db.Decimal(12, 2)
  eligiblePackageIds String[]               @default([])
  maxRedemptions     Int?
  perUserLimit       Int                    @default(1)
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean                @default(false)
  createdById        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  discountDuration   CouponDiscountDuration @default(FIRST_CYCLE)
  tenantId           String?
  codes              SalesReferralCode[]

  @@index([tenantId])
  @@index([isActive, startsAt, expiresAt])
}

model CouponRedemption {
  id                   String              @id @default(cuid())
  referralCodeId       String
  userId               String
  packageId            String
  paymentTransactionId String?             @unique
  originalAmount       Decimal             @db.Decimal(12, 2)
  discountAmount       Decimal             @db.Decimal(12, 2)
  finalAmount          Decimal             @db.Decimal(12, 2)
  status               String              @default("RESERVED")
  redeemedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenantId             String?
  package              Package             @relation(fields: [packageId], references: [id])
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  referralCode         SalesReferralCode   @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  user                 AppAuthUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([referralCodeId, status])
  @@index([userId, createdAt])
  @@index([packageId])
}

model SalesReferralEvent {
  id                   String                 @id @default(cuid())
  referralCodeId       String
  agentId              String
  userId               String?
  packageId            String?
  paymentTransactionId String?
  dealId               String?
  eventType            SalesReferralEventType
  eventKey             String?                @unique
  path                 String?
  metadata             Json?
  createdAt            DateTime               @default(now())
  tenantId             String?
  agent                SalesAgentProfile      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deal                 SalesDeal?             @relation(fields: [dealId], references: [id])
  package              Package?               @relation(fields: [packageId], references: [id])
  paymentTransaction   PaymentTransaction?    @relation(fields: [paymentTransactionId], references: [id])
  referralCode         SalesReferralCode      @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  user                 AppAuthUser?           @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([referralCodeId, eventType])
  @@index([agentId, createdAt])
  @@index([packageId])
  @@index([paymentTransactionId])
}

model SalesGoal {
  id         String             @id @default(cuid())
  name       String
  metric     SalesGoalMetric
  scope      SalesGoalScope     @default(INDIVIDUAL_AGENT)
  agentId    String?
  groupId    String?
  target     Decimal            @db.Decimal(12, 2)
  rewardText String?
  startsAt   DateTime?
  endsAt     DateTime?
  isPinned   Boolean            @default(true)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenantId   String?
  agent      SalesAgentProfile? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  group      SalesAgentGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([scope, isActive])
  @@index([agentId])
  @@index([groupId])
}

model SalesReward {
  id         String             @id @default(cuid())
  title      String
  body       String
  agentId    String?
  groupId    String?
  isPinned   Boolean            @default(true)
  isActive   Boolean            @default(true)
  unlockedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenantId   String?
  agent      SalesAgentProfile? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  group      SalesAgentGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId, isActive])
  @@index([groupId, isActive])
}

model SalesAnnouncement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("all")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String?

  @@index([tenantId])
}

model SalesMessageThread {
  id        String             @id @default(cuid())
  agentId   String?
  subject   String
  messages  Json
  status    String             @default("open")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenantId  String?
  agent     SalesAgentProfile? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId, status])
}

model SalesActivityLog {
  id                String               @id @default(cuid())
  assignmentId      String?
  actorUserId       String?
  action            String
  note              String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  tenantId          String?
  actor             AppAuthUser?         @relation(fields: [actorUserId], references: [id])
  assignment        SalesLeadAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  AicloserWorkspace AicloserWorkspace?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([assignmentId])
  @@index([actorUserId])
}

model SalesMobileRecordingProfile {
  id                    String              @id @default(cuid())
  key                   String              @unique
  manufacturer          String
  modelPattern          String
  dialerPackage         String?
  recordingCapability   String
  automationMode        String              @default("AUTO_SHARE")
  requiresAccessibility Boolean             @default(false)
  requiresFolderAccess  Boolean             @default(false)
  userActionRequired    Boolean             @default(false)
  title                 String
  instructions          Json?
  limitations           String?
  priority              Int                 @default(0)
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  devices               SalesMobileDevice[]

  @@index([manufacturer, isActive])
  @@index([modelPattern, isActive])
}

model SalesMobileDevice {
  id                  String                       @id @default(cuid())
  agentId             String
  deviceId            String                       @unique
  deviceName          String
  platform            SalesMobilePlatform          @default(ANDROID)
  appVersion          String?
  manufacturer        String?
  model               String?
  androidVersion      String?
  simLabel            String?
  officeSimNumber     String?
  recordingCapability String                       @default("UNKNOWN")
  recordingEnabled    Boolean                      @default(false)
  lastSeenAt          DateTime                     @default(now())
  isActive            Boolean                      @default(true)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  tenantId            String
  dialerPackage       String?
  recordingProfileId  String?
  calls               SalesMobileCall[]
  agent               SalesAgentProfile            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  recordingProfile    SalesMobileRecordingProfile? @relation(fields: [recordingProfileId], references: [id])
  AicloserWorkspace   AicloserWorkspace            @relation(fields: [tenantId], references: [id])
  events              SalesMobileOfflineEvent[]

  @@index([tenantId])
  @@index([agentId, isActive])
  @@index([lastSeenAt])
  @@index([recordingProfileId])
}

model SalesMobileCall {
  id                 String                     @id @default(cuid())
  assignmentId       String
  agentId            String
  deviceId           String?
  phoneNumber        String
  direction          SalesMobileCallDirection   @default(OUTBOUND)
  status             SalesMobileCallStatus      @default(INITIATED)
  startedAt          DateTime                   @default(now())
  connectedAt        DateTime?
  endedAt            DateTime?
  durationSeconds    Int?
  outcome            String?
  note               String?
  nextFollowUpAt     DateTime?
  recordingStatus    SalesMobileRecordingStatus @default(NONE)
  recordingPath      String?
  recordingMimeType  String?
  recordingSizeBytes Int?
  recordingError     String?
  noteRequired       Boolean                    @default(true)
  noteSubmitted      Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  tenantId           String
  clientCallId       String?
  agent              SalesAgentProfile          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignment         SalesLeadAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  device             SalesMobileDevice?         @relation(fields: [deviceId], references: [id])
  AicloserWorkspace  AicloserWorkspace          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, agentId, clientCallId])
  @@index([tenantId, startedAt])
  @@index([tenantId, phoneNumber])
  @@index([assignmentId, startedAt])
  @@index([agentId, noteRequired, noteSubmitted])
  @@index([deviceId, startedAt])
  @@index([clientCallId])
  @@index([tenantId, agentId])
  @@index([tenantId, agentId, startedAt(sort: Desc)])
  @@index([tenantId, recordingStatus, updatedAt])
}

model CallRecordingUpload {
  id              String                    @id @default(cuid())
  tenantId        String
  callId          String
  deviceId        String?
  clientUploadId  String
  objectKey       String
  status          CallRecordingUploadStatus @default(LOCAL_PENDING)
  mimeType        String?
  sizeBytes       Int?
  durationSeconds Int?
  checksum        String?
  attemptCount    Int                       @default(0)
  lastError       String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([tenantId, clientUploadId])
  @@index([tenantId, status, updatedAt])
  @@index([callId, createdAt])
  @@index([deviceId, status, updatedAt])
