model User {
  id                   String                    @id @default(cuid())
  email                String?                   @unique
  username             String                    @unique
  displayName          String
  passwordHash         String?
  phone                String?                   @unique
  authProvider         String                    @default("email")
  wordpressUserId      Int?                      @unique
  role                 UserRole                  @default(EDITOR)
  tenantId             String?
  onboardingStatus     VerificationStatus        @default(DRAFT)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  editorProfile        EditorProfile?
  leadsCreated         Lead[]                    @relation("LeadCreatedBy")
  assignmentsHandled   Assignment[]              @relation("AssignmentHandledBy")
  notifications        Notification[]
  managedConversations ConversationParticipant[]
  tenant               Tenant?                   @relation("TenantStaff", fields: [tenantId], references: [id])
  ownedTenant          Tenant?                   @relation("TenantOwner")
  teamInvitesSent      TeamMembership[]          @relation("TeamMembershipInvitedBy")
}

model SalesSettings {
  id                       String   @id @default("sales-settings")
  tenantId                 String?  @unique
  moduleEnabled            Boolean  @default(true)
  signupRequiresApproval   Boolean  @default(true)
  defaultCommissionPercent Decimal  @default(10) @db.Decimal(5, 2)
  payoutMinimum            Decimal  @default(500) @db.Decimal(12, 2)
  enableAnnouncements      Boolean  @default(true)
  enableMessages           Boolean  @default(true)
  enableReferralLinks      Boolean  @default(true)
  enableTeams              Boolean  @default(true)
  enableEarnings           Boolean  @default(true)
  enablePayouts            Boolean  @default(true)
  enablePackageLinks       Boolean  @default(true)
  aiAutoReplyEnabled       Boolean  @default(true)
  aiAutoReplyUpdatedById   String?
  aiAutoReplyUpdatedByName String?
  dashboardPrimaryColor    String   @default("#D7FF2F")
  dashboardAccentColor     String   @default("#0A0D0B")
  closerDirectCommissionPercent Decimal  @default(20.00) @db.Decimal(5, 2)
  closerSubCommissionPercent    Decimal  @default(10.00) @db.Decimal(5, 2)
  freelancerCommissionPercent   Decimal  @default(10.00) @db.Decimal(5, 2)
  agencyCommissionPercent       Decimal  @default(10.00) @db.Decimal(5, 2)
  payoutHoldDays                Int      @default(7)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model SalesAgentGroup {
  id                       String                @id @default(cuid())
  tenantId                 String?
  name                     String
  description              String?
  defaultCommissionPercent Decimal               @default(10) @db.Decimal(5, 2)
  parentCommissionPercent  Decimal               @default(2) @db.Decimal(5, 2)
  maxDiscountPercent       Decimal?              @db.Decimal(5, 2)
  isActive                 Boolean               @default(true)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  agents                   SalesAgentProfile[]
  commissionRules          SalesCommissionRule[]
  salesGoals               SalesGoal[]
  salesRewards             SalesReward[]

  @@index([tenantId])
}

model SalesAgentProfile {
  id                  String                    @id @default(cuid())
  tenantId            String
  userId              String                    @unique
  groupId             String?
  parentAgentId       String?
  agentCode           String                    @unique
  status              SalesAgentStatus          @default(PENDING)
  commissionPercent   Decimal?                  @db.Decimal(5, 2)
  payoutInfo          Json?
  canCreateSubAgents  Boolean                   @default(false)
  canClaimLeads       Boolean                   @default(true)
  maxActiveLeads      Int?
  permissions         Json?
  totalPaidRevenue    Decimal                   @default(0) @db.Decimal(12, 2)
  outstandingEarnings Decimal                   @default(0) @db.Decimal(12, 2)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  user                AppAuthUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group               SalesAgentGroup?          @relation(fields: [groupId], references: [id])
  parentAgent         SalesAgentProfile?        @relation("SalesAgentTree", fields: [parentAgentId], references: [id])
  subAgents           SalesAgentProfile[]       @relation("SalesAgentTree")
  workspace           AicloserWorkspace         @relation(fields: [tenantId], references: [id])
  leadAssignments     SalesLeadAssignment[]
  deals               SalesDeal[]
  earnings            SalesEarning[]
  payouts             SalesPayout[]
  referralCodes       SalesReferralCode[]
  messageThreads      SalesMessageThread[]
  commissionRules     SalesCommissionRule[]
  assignedPoolItems   SalesLeadPoolItem[]       @relation("SalesPoolAssignedAgent")
  claimedPoolItems    SalesLeadPoolItem[]       @relation("SalesPoolClaimedAgent")
  referralEvents      SalesReferralEvent[]
  goals               SalesGoal[]
  rewards             SalesReward[]
  mobileDevices       SalesMobileDevice[]
  mobileCalls         SalesMobileCall[]
  mobileEvents        SalesMobileOfflineEvent[]
  mobileLeadPacks     SalesMobileLeadPack[]

  @@index([tenantId])
  @@index([groupId])
  @@index([parentAgentId])
  @@index([status])
}

model SalesLeadAssignment {
  id              String             @id @default(cuid())
  tenantId        String
  leadId          String?
  assignedAgentId String
  createdById     String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  source          String             @default("manual")
  serviceInterest String?
  segment         String?
  priority        String             @default("normal")
  tags            String[]           @default([])
  conversationId  String?
  budgetAmount    Decimal?           @db.Decimal(10, 2)
  stage           SalesLeadStage     @default(NEW)
  followUpAt      DateTime?
  lastContactedAt DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lead            Lead?              @relation(fields: [leadId], references: [id])
  assignedAgent   SalesAgentProfile  @relation(fields: [assignedAgentId], references: [id], onDelete: Cascade)
  createdBy       AppAuthUser?       @relation("SalesLeadCreatedBy", fields: [createdById], references: [id])
  workspace       AicloserWorkspace  @relation(fields: [tenantId], references: [id])
  deals           SalesDeal[]
  activityLogs    SalesActivityLog[]
  claimedPoolItem SalesLeadPoolItem? @relation("SalesPoolConvertedAssignment")
  mobileCalls     SalesMobileCall[]

  @@index([tenantId, createdAt])
  @@index([tenantId, stage])
  @@index([tenantId, customerPhone])
  @@index([tenantId, conversationId])
  @@index([tenantId, assignedAgentId])
  @@index([assignedAgentId, stage])
  @@index([leadId])
  @@index([conversationId])
}

model SalesLeadPoolItem {
  id                    String               @id @default(cuid())
  tenantId              String
  assignedAgentId       String?
  claimedByAgentId      String?
  convertedAssignmentId String?              @unique
  customerName          String
  customerPhone         String?
  customerEmail         String?
  source                String               @default("round_robin")
  serviceInterest       String?
  segment               String?
  priority              String               @default("normal")
  budgetAmount          Decimal?             @db.Decimal(10, 2)
  status                SalesLeadPoolStatus  @default(OPEN)
  notes                 String?
  claimedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  assignedAgent         SalesAgentProfile?   @relation("SalesPoolAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  claimedByAgent        SalesAgentProfile?   @relation("SalesPoolClaimedAgent", fields: [claimedByAgentId], references: [id], onDelete: SetNull)
  convertedAssignment   SalesLeadAssignment? @relation("SalesPoolConvertedAssignment", fields: [convertedAssignmentId], references: [id], onDelete: SetNull)
  workspace             AicloserWorkspace    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([assignedAgentId, status])
  @@index([claimedByAgentId])
}

/// Durable, idempotent delivery ledger for Meta Conversions API events.
/// No raw message text or access tokens are stored here.
model MetaConversionEvent {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  eventName          String
  source             String
  datasetId          String
  tenantId           String?
  conversationId     String?
  externalMessageId  String?
  status             String   @default("PENDING")
  attemptCount       Int      @default(0)
  lastError          String?
  traceId            String?
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([source, createdAt])
  @@index([conversationId])
  @@index([externalMessageId])
  @@map("meta_conversion_events")
}

model SalesDeal {
  id                   String               @id @default(cuid())
  tenantId             String?
  assignmentId         String
  agentId              String
  packageId            String?
  serviceId            String?
  quoteId              String?
  paymentTransactionId String?              @unique
  referralCodeId       String?
  title                String
  agreedAmount         Decimal              @db.Decimal(12, 2)
  paidAmount           Decimal              @default(0) @db.Decimal(12, 2)
  status               SalesDealStatus      @default(DRAFT)
  paymentReference     String?
  closedAt             DateTime?
  handoffNotes         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  assignment           SalesLeadAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  agent                SalesAgentProfile    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  package              Package?             @relation(fields: [packageId], references: [id])
  service              Service?             @relation(fields: [serviceId], references: [id])
  quote                Quote?               @relation(fields: [quoteId], references: [id])
  paymentTransaction   PaymentTransaction?  @relation(fields: [paymentTransactionId], references: [id])
  referralCode         SalesReferralCode?   @relation(fields: [referralCodeId], references: [id])
  earnings             SalesEarning[]
  referralEvents       SalesReferralEvent[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([agentId, status])
  @@index([assignmentId])
  @@index([paymentTransactionId])
  @@index([referralCodeId])
}

model SalesCommissionRule {
  id                      String                   @id @default(cuid())
  tenantId                String?
  name                    String
  type                    SalesCommissionRuleType
  scope                   SalesCommissionScope     @default(ALL_AGENTS)
  appliesTo               SalesCommissionAppliesTo @default(ALL_PACKAGES)
  groupId                 String?
  agentId                 String?
  packageId               String?
  serviceId               String?
  value                   Decimal                  @db.Decimal(10, 2)
  parentCommissionPercent Decimal?                 @db.Decimal(5, 2)
  minOrderValue           Decimal?                 @db.Decimal(12, 2)
  maxOrderValue           Decimal?                 @db.Decimal(12, 2)
  priority                Int                      @default(0)
  isActive                Boolean                  @default(true)
  startsAt                DateTime?
  endsAt                  DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  group                   SalesAgentGroup?         @relation(fields: [groupId], references: [id])
  agent                   SalesAgentProfile?       @relation(fields: [agentId], references: [id])
  package                 Package?                 @relation(fields: [packageId], references: [id])
  service                 Service?                 @relation(fields: [serviceId], references: [id])

  @@index([tenantId])
  @@index([scope, isActive, priority])
  @@index([agentId])
  @@index([packageId])
  @@index([serviceId])
}

model SalesEarning {
  id           String             @id @default(cuid())
  tenantId     String?
  dealId       String
  agentId      String
  ruleId       String?
  amount       Decimal            @db.Decimal(12, 2)
  parentAmount Decimal            @default(0) @db.Decimal(12, 2)
  status       SalesEarningStatus @default(PENDING)
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deal         SalesDeal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agent        SalesAgentProfile  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  payout       SalesPayout?       @relation(fields: [payoutId], references: [id])
  payoutId     String?

  @@index([tenantId, createdAt])
  @@index([agentId, status])
  @@index([dealId])
}

model SalesPayout {
  id          String            @id @default(cuid())
  tenantId    String?
  agentId     String
  amount      Decimal           @db.Decimal(12, 2)
  status      SalesPayoutStatus @default(REQUESTED)
  note        String?
  requestedAt DateTime          @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  agent       SalesAgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  earnings    SalesEarning[]

  @@index([tenantId, createdAt])
  @@index([agentId, status])
}

model SalesReferralCode {
  id                 String               @id @default(cuid())
  tenantId           String?
  agentId            String
  campaignId         String?
  code               String               @unique
  label              String?
  discountType       CouponDiscountType?
  discountValue      Decimal?             @db.Decimal(12, 2)
  discountDuration   CouponDiscountDuration @default(FIRST_CYCLE)
  eligiblePackageIds String[]             @default([])
  maxRedemptions     Int?
  perUserLimit       Int                  @default(1)
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  agent              SalesAgentProfile    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  campaign           CouponCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deals              SalesDeal[]
  events             SalesReferralEvent[]
  redemptions        CouponRedemption[]

  @@index([tenantId])
  @@index([campaignId])
}

model CouponCampaign {
  id                 String              @id @default(cuid())
  tenantId           String?
  name               String
  discountType       CouponDiscountType
  discountValue      Decimal             @db.Decimal(12, 2)
  discountDuration   CouponDiscountDuration @default(FIRST_CYCLE)
  eligiblePackageIds String[]            @default([])
  maxRedemptions     Int?
  perUserLimit       Int                 @default(1)
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean             @default(false)
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  codes              SalesReferralCode[]

  @@index([tenantId])
  @@index([isActive, startsAt, expiresAt])
}

model CouponRedemption {
  id                   String              @id @default(cuid())
  tenantId             String?
  referralCodeId       String
  userId               String
  packageId            String
  paymentTransactionId String?             @unique
  originalAmount       Decimal             @db.Decimal(12, 2)
  discountAmount       Decimal             @db.Decimal(12, 2)
  finalAmount          Decimal             @db.Decimal(12, 2)
  status               String              @default("RESERVED")
  redeemedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  referralCode         SalesReferralCode   @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  user                 AppAuthUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package              Package             @relation(fields: [packageId], references: [id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([referralCodeId, status])
  @@index([userId, createdAt])
  @@index([packageId])
}

model SalesReferralEvent {
  id                   String                 @id @default(cuid())
  tenantId             String?
  referralCodeId       String
  agentId              String
  userId               String?
  packageId            String?
  paymentTransactionId String?
  dealId               String?
  eventType            SalesReferralEventType
  eventKey             String?                @unique
  path                 String?
  metadata             Json?
  createdAt            DateTime               @default(now())
  referralCode         SalesReferralCode      @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  agent                SalesAgentProfile      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user                 AppAuthUser?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  package              Package?               @relation(fields: [packageId], references: [id], onDelete: SetNull)
  paymentTransaction   PaymentTransaction?    @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  deal                 SalesDeal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([referralCodeId, eventType])
  @@index([agentId, createdAt])
  @@index([packageId])
  @@index([paymentTransactionId])
}

model SalesGoal {
  id         String             @id @default(cuid())
  tenantId   String?
  name       String
  metric     SalesGoalMetric
