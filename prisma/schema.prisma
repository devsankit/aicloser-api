  @@index([tenantId, channel, status])
  @@index([conversationId])
  @@index([updatedAt])
  @@map("whatsapp_flow_runs")
}

model WhatsAppFlowEvent {
  id           String           @id @default(cuid())
  flowRunId    String?
  flowId       String?
  tenantId     String?
  nodeId       String?
  eventType    String
  inputJson    Json?
  outputJson   Json?
  status       String
  errorMessage String?
  createdAt    DateTime         @default(now())
  flowRun      WhatsAppFlowRun? @relation(fields: [flowRunId], references: [id], onDelete: SetNull)
  flow         WhatsAppFlow?    @relation(fields: [flowId], references: [id], onDelete: SetNull)

  @@index([flowRunId, createdAt])
  @@index([flowId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@index([eventType, createdAt])
  @@map("whatsapp_flow_events")
}

model WhatsAppWebhookMessageEvent {
  id            String    @id @default(cuid())
  provider      String
  messageId     String
  phoneNumberId String?
  tenantId      String?
  agencyId      String?
  payloadJson   Json
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([provider, messageId])
  @@index([phoneNumberId, createdAt])
  @@index([tenantId, createdAt])
  @@map("whatsapp_webhook_message_events")
}

model KnowledgeBaseCategory {
  id          String                    @id
  role        KnowledgeBaseAudienceRole
  slug        String
  title       String
  description String
  iconKey     String
  sortOrder   Int                       @default(100)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([role, slug])
  @@index([role, sortOrder])
}

model KnowledgeBaseArticle {
  id                 String                     @id
  role               KnowledgeBaseAudienceRole
  categoryId         String?
  slug               String
  title              String
  summary            String
  intro              String
  bodyBlocks         Json
  steps              Json
  importantNotes     String[]
  faqs               Json
  relatedSlugs       String[]
  tags               String[]
  filterGroups       String[]
  mediaIds           String[]
  videoUrl           String?
  videoTitle         String?
  seoTitle           String
  seoDescription     String
  readingMinutes     Int                        @default(2)
  status             KnowledgeBaseArticleStatus @default(DRAFT)
  botTrainingEnabled Boolean                    @default(true)
  popular            Boolean                    @default(false)
  topSearched        Boolean                    @default(false)
  publishedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([role, slug])
  @@index([status, role])
  @@index([categoryId])
}

model KnowledgeBaseMedia {
  id           String                 @id
  kind         KnowledgeBaseMediaKind
  title        String
  alt          String
  url          String
  mobileUrl    String?
  thumbnailUrl String?
  sortOrder    Int                    @default(100)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model KnowledgeBaseChunk {
  id        String                    @id
  articleId String
  role      KnowledgeBaseAudienceRole
  slug      String
  title     String
  content   String
  keywords  String[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([articleId])
  @@index([role])
}

model KnowledgeBaseFeedback {
  id        String   @id
  articleId String
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now())

  @@index([articleId])
}

model KnowledgeBaseSearchEvent {
  id          String                     @id
  query       String
  role        KnowledgeBaseAudienceRole?
  filters     String[]
  resultCount Int
  createdAt   DateTime                   @default(now())

  @@index([createdAt])
  @@index([role])
}

model SupportBotSession {
  id                    String                  @id
  visitorName           String?
  visitorPhone          String?
  status                SupportBotSessionStatus @default(ACTIVE)
  handoffConversationId String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model SupportBotMessage {
  id        String                @id
  sessionId String
  role      SupportBotMessageRole
  body      String
  sources   Json?
  createdAt DateTime              @default(now())

  @@index([sessionId, createdAt])
}

// --------------------------------------------------------
// WhatsApp Marketing Engine Enums & Models
// --------------------------------------------------------

enum WhatsAppChannelStatus {
  ACTIVE
  PENDING_VERIFICATION
  RESTRICTED
  DISCONNECTED
}

enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum WhatsAppTemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum WhatsAppHeaderType {
  NONE
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

enum MarketingContactOptInStatus {
  OPTED_IN
  OPTED_OUT
  UNKNOWN
}

enum ContactImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum WhatsAppCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum WhatsAppRecipientStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum WhatsAppMessageStatus {
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppSuppressionReason {
  OPT_OUT
  BOUNCE
  SPAM_COMPLAINT
  MANUAL_BLOCK
}

model WhatsAppChannel {
  id                  String                @id @default(cuid())
  tenantId            String
  businessId          String?
  businessPortfolioId String?
  wabaId              String
  phoneNumberId       String                @unique
  displayPhoneNumber  String
  verifiedName        String?
  qualityRating       String?
  messagingLimitTier  String?
  status              WhatsAppChannelStatus @default(ACTIVE)
  graphApiVersion     String                @default("v22.0")
  webhookVerifyToken  String?
  encryptedAccessToken String?
  isDefault           Boolean               @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  templates           WhatsAppTemplate[]
  campaigns           WhatsAppCampaign[]

  @@index([tenantId])
}

model WhatsAppTemplate {
  id              String                   @id @default(cuid())
  tenantId        String
  channelId       String
  metaTemplateId  String?
  name            String
  language        String                   @default("en_US")
  category        WhatsAppTemplateCategory @default(MARKETING)
  status          WhatsAppTemplateStatus   @default(DRAFT)
  rejectionReason String?
  qualityRating   String?
  headerType      WhatsAppHeaderType       @default(NONE)
  headerContent   String?
  headerHandle    String?
  bodyText        String
  footerText      String?
  buttons         Json?
  exampleValues   Json?
  hasVariables    Boolean                  @default(false)
  variableCount   Int                      @default(0)
  isLatestVersion Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  channel         WhatsAppChannel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  versions        WhatsAppTemplateVersion[]
  campaigns       WhatsAppCampaign[]

  @@unique([tenantId, name, language])
  @@index([tenantId])
  @@index([channelId])
  @@index([status])
}

model WhatsAppTemplateVersion {
  id            String             @id @default(cuid())
  templateId    String
  versionNumber Int
  headerType    WhatsAppHeaderType @default(NONE)
  headerContent String?
  bodyText      String
  footerText    String?
  buttons       Json?
  exampleValues Json?
  metaStatus    String?
  createdAt     DateTime           @default(now())

  template      WhatsAppTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

model WhatsAppTemplateSyncLog {
  id               String   @id @default(cuid())
  tenantId         String
  channelId        String
  syncType         String   @default("FULL_SYNC")
  status           String   @default("SUCCESS")
  templatesCreated Int      @default(0)
  templatesUpdated Int      @default(0)
  templatesDeleted Int      @default(0)
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([channelId])
}

model MarketingContact {
  id                 String                      @id @default(cuid())
  tenantId           String
  firstName          String?
  lastName           String?
  fullName           String
  e164Phone          String
  email              String?
  source             String                      @default("MANUAL")
  leadId             String?
  assignedAgentId    String?
  optInStatus        MarketingContactOptInStatus @default(UNKNOWN)
  optInSource        String?
  optInAt            DateTime?
  optOutSource       String?
  optOutAt           DateTime?
  timeZone           String?                     @default("Asia/Kolkata")
  tags               String[]                    @default([])
  customFields       Json?
  lastCampaignSentAt DateTime?
  lastDeliveredAt    DateTime?
  lastReadAt         DateTime?
  lastRepliedAt      DateTime?
  isBlocked          Boolean                     @default(false)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  groupMemberships   ContactGroupMembership[]
  campaignRecipients WhatsAppCampaignRecipient[]
  optIns             WhatsAppOptIn[]
  workspace          AicloserWorkspace           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, e164Phone])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([e164Phone])
  @@index([optInStatus])
}

model ContactGroup {
  id          String                   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  memberCount Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  memberships ContactGroupMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ContactGroupMembership {
  id        String           @id @default(cuid())
  groupId   String
  contactId String
  createdAt DateTime         @default(now())

  group     ContactGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([groupId])
  @@index([contactId])
}

model ContactImportJob {
  id              String                 @id @default(cuid())
  tenantId        String
  source          String                 @default("GOOGLE_SHEETS")
  fileName        String?
  totalRows       Int                    @default(0)
  validRows       Int                    @default(0)
  invalidRows     Int                    @default(0)
  duplicateRows   Int                    @default(0)
  status          ContactImportJobStatus @default(PENDING)
  consentDeclared Boolean                @default(false)
  consentSource   String?
  createdById     String?
  createdAt       DateTime               @default(now())
  completedAt     DateTime?

  rowErrors       ContactImportRowError[]

  @@index([tenantId])
}

model ContactImportRowError {
  id           String           @id @default(cuid())
  importJobId  String
  rowNumber    Int
  rawData      Json?
  errorCode    String
  errorMessage String
  createdAt    DateTime         @default(now())

  importJob    ContactImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
}

model WhatsAppCampaign {
  id               String                 @id @default(cuid())
  tenantId         String
  channelId        String
  templateId       String
  templateLanguage String                 @default("en_US")
  name             String
  status           WhatsAppCampaignStatus @default(DRAFT)
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  totalRecipients  Int                    @default(0)
  sentCount        Int                    @default(0)
  deliveredCount   Int                    @default(0)
  readCount        Int                    @default(0)
  failedCount      Int                    @default(0)
  repliedCount     Int                    @default(0)
  variableMappings Json?
  createdById      String?
  timezone         String                 @default("Asia/Kolkata")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  channel          WhatsAppChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  template         WhatsAppTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipients       WhatsAppCampaignRecipient[]
  messages         WhatsAppCampaignMessage[]

  @@index([tenantId])
  @@index([channelId])
  @@index([status])
}

model WhatsAppCampaignRecipient {
  id                String                  @id @default(cuid())
  campaignId        String
  contactId         String
  e164Phone         String
  status            WhatsAppRecipientStatus @default(QUEUED)
  skipReason        String?
  resolvedVariables Json?
  idempotencyKey    String                  @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?
  retryCount        Int                     @default(0)
  createdAt         DateTime                @default(now())

  campaign          WhatsAppCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           MarketingContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages          WhatsAppCampaignMessage[]

  @@index([campaignId])
  @@index([contactId])
  @@index([status])
}

model WhatsAppCampaignMessage {
  id           String                @id @default(cuid())
  campaignId   String
  recipientId  String
  wamid        String                @unique
  status       WhatsAppMessageStatus @default(ACCEPTED)
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  errorMessage String?
  rawPayload   Json?
  createdAt    DateTime              @default(now())

  campaign     WhatsAppCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient    WhatsAppCampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([recipientId])
  @@index([wamid])
}

model WhatsAppMessageEvent {
  id         String   @id @default(cuid())
  tenantId   String
  wamid      String
  eventType  String
  occurredAt DateTime @default(now())
  rawPayload Json?
  campaignId String?
  contactId  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([wamid])
  @@index([eventType])
}

model WhatsAppSuppression {
  id        String                    @id @default(cuid())
  tenantId  String
  e164Phone String
  reason    WhatsAppSuppressionReason @default(OPT_OUT)
  source    String?
  expiresAt DateTime?
  createdAt DateTime                  @default(now())

  @@unique([tenantId, e164Phone])
  @@index([tenantId])
  @@index([e164Phone])
}

model WhatsAppOptIn {
  id          String           @id @default(cuid())
  tenantId    String
  contactId   String
  e164Phone   String
  consentType String           @default("EXPLICIT_MARKETING")
  proofSource String?
  ipAddress   String?
  userAgent   String?
  consentedAt DateTime         @default(now())

  contact     MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([e164Phone])
}

model WhatsAppAuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}

