PORT=3060
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/aicloser?schema=public"
JWT_SECRET="your-jwt-secret-here"
CORS_ORIGIN="http://localhost:3011,https://app.aicloser.com"
WEBHOOK_APP_SECRET="your-meta-webhook-secret"
SUPER_ADMIN_AUDIT_ENABLED=true
RECORDING_STORAGE_DRIVER=local
RECORDING_STORAGE_PATH=./data/recordings
# Set RECORDING_STORAGE_DRIVER=s3 for production/private object storage.
RECORDING_STORAGE_BUCKET=
RECORDING_STORAGE_REGION=auto
RECORDING_STORAGE_ENDPOINT=
RECORDING_STORAGE_ACCESS_KEY_ID=
RECORDING_STORAGE_SECRET_ACCESS_KEY=
RECORDING_SIGNED_URL_SECONDS=300
REDIS_URL=
